{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "dart": {
      "command": [
        ".fvm/flutter_sdk/bin/dart",
        "language-server",
        "--protocol=lsp"
      ]
    }
  },
  "mcp": {
    "dart": {
      "type": "local",
      "command": [
        ".fvm/flutter_sdk/bin/dart",
        "mcp-server",
        "--flutter-sdk",
        ".fvm/flutter_sdk"
      ],
      "enabled": true
    }
  }
}
